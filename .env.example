DISCORD_TOKEN=
# Select one: google (default), deepl, azure, gemini, openai,
# or openai-compatible.
TRANSLATION_PROVIDER=google

# google: Google Cloud Translation Basic (v2)
GOOGLE_TRANSLATE_API_KEY=
# Optional custom endpoint, for compatible Google Translation v2 endpoints.
# GOOGLE_TRANSLATE_URL=https://translation.googleapis.com/language/translate/v2

# deepl: use the Free endpoint by default; set DEEPL_API_URL for Pro.
# DEEPL_AUTH_KEY=
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# azure: set REGION when required by your Translator resource.
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_URL=https://api.cognitive.microsofttranslator.com/translate

# gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions

# OpenAI-compatible endpoint (for example, a self-hosted service)
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_BASE_URL=https://example.com/v1

# Optional override for the YAML max_per_minute setting.
# MAX_PER_MINUTE=30
