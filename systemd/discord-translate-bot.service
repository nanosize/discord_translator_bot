[Unit]
Description=Discord Translate Bot
After=network.target

[Service]
Type=simple
User=discordbot
WorkingDirectory=/opt/discord_translator_bot
EnvironmentFile=/opt/discord_translator_bot/.env
Environment=CONFIG_FILE=/opt/discord_translator_bot/config.yml
ExecStart=/opt/discord_translator_bot/discord-translator-bot
Restart=on-failure
RestartSec=10
# 標準出力・エラーをログに流す
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=discord-translate-bot

[Install]
WantedBy=multi-user.target
